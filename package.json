{
  "name": "trendyol-yorum-cekme",
  "version": "0.1.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/efecun-dev/limon-panel.git"
  },
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder --publish always",
    "deploy": "npm version patch && git push --follow-tags"
  },
  "build": {
    "appId": "com.limonsupermarket.panel",
    "productName": "Limon Panel",
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*",
      ".next/**/*",
      "public/**/*",
      ".env.local"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/limonlogo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Limon Panel"
    }
  },
  "dependencies": {
    "axios": "^1.20.0",
    "electron-updater": "^6.8.9",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
